# Настройки Copilot. Ключи можно безопасно сохранить через GUI в Windows Credential Manager.
PROVIDER=offline
MODEL=gpt-4.1-mini
API_BASE_URL=https://api.openai.com/v1
API_KEY=
VISION=true
REQUEST_TIMEOUT=45
INTERVAL_SECONDS=8
ANALYSIS_CACHE_SECONDS=30
PACK_VERSION=unspecified
DATABASE_PATH=data/copilot.sqlite3
WINDOW_TITLE_PATTERN=(?i)minecraft|loliland|LoliLand Agent Test
SPEECH_ENABLED=false
SPEECH_VOLUME=80
SPEECH_RATE=1.0
TTS_PROVIDER=system
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
STT_PROVIDER=disabled
STT_MODEL=gpt-4o-mini-transcribe
SPEECH_API_BASE_URL=https://api.openai.com/v1
SPEECH_API_KEY=
VOICE_MODE=ptt
PTT_HOTKEY=CTRL+ALT+F6
WHISPER_MODEL=tiny
ALLOW_MODEL_DOWNLOAD=false
VAD_THRESHOLD=0.015
VAD_SILENCE=0.7
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=

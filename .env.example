# This configuration belongs to Copilot, never to Minecraft or its launcher.
PROVIDER=offline
# openai | compatible | ollama | offline
MODEL=gpt-4.1-mini
API_BASE_URL=https://api.openai.com/v1
API_KEY=
VISION=true
REQUEST_TIMEOUT=45
INTERVAL_SECONDS=8
ANALYSIS_CACHE_SECONDS=30
PACK_VERSION=unspecified
DATABASE_PATH=data/copilot.sqlite3
WINDOW_TITLE_PATTERN=(?i)minecraft|loliland|LoliLand Agent Test
SPEECH_ENABLED=false
SPEECH_VOLUME=80
# Optional actual model prices per million tokens; blank means cost unknown.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=

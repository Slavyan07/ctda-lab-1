# Бесплатный локальный Copilot. Ключи, аккаунты и подписки не нужны.
FREE_MODE=true
PROVIDER=ollama
MODEL=qwen3-vl:4b
API_BASE_URL=http://127.0.0.1:11434/v1
VISION=true
REQUEST_TIMEOUT=180
INTERVAL_SECONDS=8
ANALYSIS_CACHE_SECONDS=30
PACK_VERSION=unspecified
DATABASE_PATH=data/copilot.sqlite3
WINDOW_TITLE_PATTERN=(?i)minecraft|loliland|LoliLand Agent Test
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1200
# CPU по умолчанию сохраняет VRAM для Minecraft; частичный offload на свой бюджет.
OLLAMA_NUM_GPU=0
OLLAMA_THREADS=4
MAX_MODEL_RAM_MB=5120
MAX_MODEL_VRAM_MB=1536
MIN_FREE_RAM_MB=2048
UNLOAD_AFTER_REQUEST=true
LOCAL_IMAGE_MAX_EDGE=768
MAX_FAILED_ATTEMPTS=3
SPEECH_ENABLED=false
SPEECH_VOLUME=80
SPEECH_RATE=1.0
TTS_PROVIDER=piper
TTS_VOICE=ru_RU-irina-medium
STT_PROVIDER=local
VOICE_MODE=ptt
PTT_HOTKEY=CTRL+ALT+F6
WHISPER_MODEL=tiny
ALLOW_MODEL_DOWNLOAD=false
VAD_THRESHOLD=0.015
VAD_SILENCE=0.7
